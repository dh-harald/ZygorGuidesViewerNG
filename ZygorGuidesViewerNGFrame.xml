<?xml version="1.0"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/FrameXML\UI.xsd">
    <Script file="ZygorGuidesViewerNGFrame.lua"/>

    <Frame name="ZygorGuidesViewerNGFrame" toplevel="true" movable="true" parent="UIParent" enableMouse="true" hidden="true">
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER" />
        </Anchors>
        <Size x="240" y="128" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" setAllPoints="true">
                    <Color r="0.1" g="0.1" b="0.1" a="0.9"/>
                </Texture>
            </Layer>
        </Layers>
        <BackdropInsets>
            <AbsInset left="1" right="1" top="1" bottom="1"/>
        </BackdropInsets>

        <Frames>
            <Frame name="$parentTitleBar" movable="true" enableMouse="true">
                <Size x="240" y="20" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="0" y="0" />
                    </Anchor>
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
                        <Offset x="0" y="0" />
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentLogo" file="Interface\AddOns\ZygorGuidesViewerNG\Skins\zygorlogo">
                            <Size x="64" y="16" />
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="CENTER">
                                    <Offset x="0" y="-2" />
                                </Anchor>
                            </Anchors>
                            <!-- <TexCoords left="0" right="0.87" top="0" bottom="1"/> -->
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Button name="$parentLockButton">
                        <Size x="12" y="12" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                                <Offset x="2" y="-4" />
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons" />
                        <HighlightTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons" alphaMode="ADD" />
                        <PushedTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons" />
                        <Scripts>
                            <OnShow>
                                ZGV:ViewerFrameSetLockIcon(this)
                            </OnShow>
                            <OnEnter>
                                if ZGV.db.char.viewer.locked then
                                    ZGV:ButtonTooltip("Unlock")
                                else
                                    ZGV:ButtonTooltip("Lock")
                                end
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                            <OnClick>
                                ZGV:ViewerFrameLock(this)
                                if ZGV.db.char.viewer.locked then
                                    ZGV:ButtonTooltip("Unlock")
                                else
                                    ZGV:ButtonTooltip("Lock")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>
                    <Button name="$parentSettingsButton">
                        <Size x="12" y="12" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
                                <Offset x="-16" y="-4" />
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons">
                            <TexCoords top="0" left="0.5" bottom="0.2421875" right="0.7421875"/>
                        </NormalTexture>
                        <HighlightTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons" alphaMode="ADD">
                            <TexCoords top="0.25" left="0.5" bottom="0.4921875" right="0.7421875"/>
                        </HighlightTexture>
                        <PushedTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons">
                            <TexCoords top="0.25" left="0.5" bottom="0.4921875" right="0.7421875"/>
                        </PushedTexture>
                        <Scripts>
                            <OnClick>
                                ZGV:OpenOptions()
                            </OnClick>
                            <OnEnter>
                                ZGV:ButtonTooltip("Settings")
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                        </Scripts>
                    </Button>
                    <Button name="$parentCloseButton">
                        <Size x="12" y="12" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
                                <Offset x="-2" y="-4" />
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons">
                            <TexCoords top="0" left="0.75" bottom="0.2421875" right="1"/>
                        </NormalTexture>
                        <HighlightTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons" alphaMode="ADD">
                            <TexCoords top="0.25" left="0.75" bottom="0.4921875" right="1"/>
                        </HighlightTexture>
                        <PushedTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\titlebuttons">
                            <TexCoords top="0.25" left="0.75" bottom="0.4921875" right="1"/>
                        </PushedTexture>
                        <Scripts>
                            <OnEnter>
                                ZGV:ButtonTooltip("Close")
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                            <OnClick>
                                ZGV:ViewerFrameToggle()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
                <Scripts>
                    <OnMouseDown>
                        ZGV:ViewerFrameOnMouseDown(this:GetParent())
                    </OnMouseDown>
                    <OnMouseUp>
                        ZGV:ViewerFrameOnMouseUp(this:GetParent())
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- Guide name bar: replaces Zygor's multi-guide tab strip with a single label,
                 since this addon only shows one guide at a time. -->
            <Frame name="$parentGuideNameBar">
                <Size x="240" y="18" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentTitleBar" relativePoint="BOTTOMLEFT" />
                    <Anchor point="TOPRIGHT" relativeTo="$parentTitleBar" relativePoint="BOTTOMRIGHT" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture setAllPoints="true">
                            <Color r="0.2" g="0.2" b="0.2" a="1" />
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString name="$parentText" inherits="GameFontNormal" justifyH="LEFT">
                            <Size x="228" y="16" />
                            <Anchors>
                                <Anchor point="LEFT">
                                    <Offset x="6" y="0" />
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Navigation bar: step number + prev/next, no party-sync/flag/menu icons yet. -->
            <Frame name="$parentNavBar">
                <Size x="240" y="18" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentGuideNameBar" relativePoint="BOTTOMLEFT" />
                    <Anchor point="TOPRIGHT" relativeTo="$parentGuideNameBar" relativePoint="BOTTOMRIGHT" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture setAllPoints="true">
                            <Color r="0.25" g="0.25" b="0.25" a="1" />
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <!-- Fixed-width slot between the two arrows (prev button: x=4, 16 wide), so
                             the centered step number never runs under either button. -->
                        <FontString name="$parentStepText" inherits="GameFontNormal" justifyH="CENTER">
                            <Size x="40" y="18" />
                            <Anchors>
                                <Anchor point="LEFT">
                                    <Offset x="20" y="0" />
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button name="$parentPrevButton">
                        <Size x="16" y="16" />
                        <Anchors>
                            <Anchor point="LEFT">
                                <Offset x="4" y="0" />
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.00390625" left="0.0078125" bottom="0.24609375" right="0.4921875"/>
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.25390625" left="0.0078125" bottom="0.49609375" right="0.4921875"/>
                        </PushedTexture>
                        <HighlightTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons" alphaMode="ADD">
                            <TexCoords top="0.25390625" left="0.0078125" bottom="0.49609375" right="0.4921875"/>
                        </HighlightTexture>
                        <DisabledTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.75390625" left="0.0078125" bottom="0.99609375" right="0.4921875"/>
                        </DisabledTexture>
                        <Scripts>
                            <OnClick>
                                ZGV:StepBack()
                            </OnClick>
                        </Scripts>
                    </Button>
                    <Button name="$parentNextButton">
                        <Size x="16" y="16" />
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parentStepText" relativePoint="RIGHT">
                                <Offset x="0" y="0" />
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.00390625" left="0.5078125" bottom="0.24609375" right="0.9921875"/>
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.25390625" left="0.5078125" bottom="0.49609375" right="0.9921875"/>
                        </PushedTexture>
                        <HighlightTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons" alphaMode="ADD">
                            <TexCoords top="0.25390625" left="0.5078125" bottom="0.49609375" right="0.9921875"/>
                        </HighlightTexture>
                        <DisabledTexture file="Interface\AddOns\ZygorGuidesViewerNG\Skins\stepbuttons">
                            <TexCoords top="0.75390625" left="0.5078125" bottom="0.99609375" right="0.9921875"/>
                        </DisabledTexture>
                        <Scripts>
                            <OnLoad>
                                this:RegisterForClicks("LeftButtonUp", "RightButtonUp")
                            </OnLoad>
                            <OnEnter>
                                ZGV:NextButtonOnEnter()
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                            <OnClick>
                                ZGV:NextButtonOnClick(arg1)
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>

            <!-- Progress bar: whole-guide completion (steps done / total steps), set in
                 ZGV:UpdateFrame. Inset from the frame edges over a #454545 track, the way the
                 Classic skin's Starlight style lays it out (its border color is transparent,
                 so the track itself is what reads as the bar's outline). The inset is 2px, not
                 Starlight's 5/4: the frame is narrower here. Its height and bottom inset are
                 part of UpdateFrame's chrome-height sum. -->
            <StatusBar name="$parentProgressBar" minValue="0" maxValue="1" defaultValue="0">
                <Size x="240" y="7" />
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT">
                        <Offset><AbsDimension x="2" y="2" /></Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
                        <Offset><AbsDimension x="-2" y="2" /></Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture setAllPoints="true">
                            <Color r="0.27" g="0.27" b="0.27" a="1" />
                        </Texture>
                    </Layer>
                </Layers>
                <BarTexture file="Interface\TargetingFrame\UI-StatusBar" />
                <BarColor r="0.2" g="0.8" b="0.2" />
            </StatusBar>

            <!-- Content: goal rows are created/reused dynamically in Lua (ZGV:UpdateFrame),
                 since the row count varies per step. -->
            <Frame name="$parentContent">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentNavBar" relativePoint="BOTTOMLEFT" />
                    <Anchor point="TOPRIGHT" relativeTo="$parentNavBar" relativePoint="BOTTOMRIGHT" />
                    <!-- The progress bar is inset horizontally; the goal rows are not. -->
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentProgressBar" relativePoint="TOPLEFT">
                        <Offset><AbsDimension x="-2" y="2" /></Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentProgressBar" relativePoint="TOPRIGHT">
                        <Offset><AbsDimension x="2" y="2" /></Offset>
                    </Anchor>
                </Anchors>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                ZGV:ViewerFrameOnLoad(this)
            </OnLoad>
            <OnMouseDown>
                ZGV:ViewerFrameOnMouseDown(this)
            </OnMouseDown>
            <OnMouseUp>
                ZGV:ViewerFrameOnMouseUp(this)
            </OnMouseUp>
        </Scripts>
    </Frame>
</Ui>
